# Blank values are treated as unset. Only DB_URL is required; everything else
# shows its default. Durations are in seconds unless the name ends in _MS.

# --- Server ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Comma separated list of allowed origins. Leave blank to disable CORS.
CORS_ORIGIN=
REQUEST_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=72000
# Hard deadline for the whole graceful shutdown. Keep above LIFECYCLE_STOP_TIMEOUT_MS.
SHUTDOWN_TIMEOUT_MS=15000

# --- Infrastructure lifecycle (per resource) ---
LIFECYCLE_START_TIMEOUT_MS=15000
LIFECYCLE_STOP_TIMEOUT_MS=10000
LIFECYCLE_CHECK_TIMEOUT_MS=2000

# --- Rate limiting (token bucket per client IP, state in Redis) ---
RATE_LIMIT_ENABLED=true
# Bucket size: the burst a client may spend at once
RATE_LIMIT_CAPACITY=60
# Tokens added per second: the sustained rate (fractions allowed, 0.5 = one per 2s)
RATE_LIMIT_REFILL_PER_SECOND=1
# Give up on Redis after this long
RATE_LIMIT_TIMEOUT_MS=200
# true: allow requests when Redis fails. false: answer 503.
RATE_LIMIT_FAIL_OPEN=true
# Trust X-Forwarded-For. Enable ONLY behind a proxy you control, or clients can spoof their IP.
TRUST_PROXY=false

# --- Redis (node-redis) ---
REDIS_URL=redis://localhost:6379
# Prepended to every key, so apps can share one Redis
REDIS_KEY_PREFIX=rnd:
REDIS_CLIENT_NAME=rnd
REDIS_DATABASE=
REDIS_CONNECT_TIMEOUT_MS=5000
# Close a socket silent for this long (blank = no timeout)
REDIS_SOCKET_TIMEOUT_MS=
# PING interval to keep idle connections alive (blank = never)
REDIS_PING_INTERVAL_MS=
# Fail commands immediately while disconnected instead of queueing them
REDIS_DISABLE_OFFLINE_QUEUE=true
# Reconnect attempts allowed during startup before giving up
REDIS_STARTUP_RETRIES=2

# --- Postgres (postgres.js) ---
# Host, port, database, user and password all come from the URL.
# Must match the POSTGRES_* values below when using docker compose.
DB_URL=postgres://rnd:rnd@localhost:5432/rnd

# TLS: disable | allow | prefer | require | verify-full (blank = from the URL)
DB_SSL=
# postgres | direct (direct needs PostgreSQL 17+)
DB_SSL_NEGOTIATION=
# disable | prefer | require
DB_CHANNEL_BINDING=

# Pool
DB_MAX=10
DB_MIN=0
DB_MAX_PIPELINE=100
DB_SCHEDULER=true
# Seconds before an idle connection closes (0 = keep open)
DB_IDLE_TIMEOUT=30
# Seconds a query waits for a free connection (0 = forever)
DB_QUEUE_TIMEOUT=10
DB_CONNECT_TIMEOUT=10
# Seconds a connection lives at most (blank = driver default, 30-60 min; 0 = no limit)
DB_MAX_LIFETIME=
# Seconds before reconnecting after a failure (blank = exponential backoff)
DB_BACKOFF=
# Seconds of TCP keep-alive (0 = off)
DB_KEEP_ALIVE=60

# Protocol and types. Set DB_PREPARE=false behind PgBouncer in transaction mode.
DB_PREPARE=true
DB_INFER=false
DB_FETCH_TYPES=true
# read-write | read-only | primary | standby | prefer-standby (multi-host URLs)
DB_TARGET_SESSION_ATTRS=

# Logical replication (sql.subscribe)
DB_PUBLICATIONS=
DB_SLOT=

# Sockets
DB_ONREAD=true
DB_UNREF_SOCKETS=false

# Log every query (never parameter values) at debug level
DB_DEBUG=false

# Run-time parameters sent at connection start
DB_APPLICATION_NAME=rnd
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=
DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=60000
DB_IDLE_SESSION_TIMEOUT_MS=
DB_TIMEZONE=
# read uncommitted | read committed | repeatable read | serializable
DB_DEFAULT_TRANSACTION_ISOLATION=
DB_DEFAULT_TRANSACTION_READ_ONLY=

# Seconds in-flight queries get to finish when the pool closes
DB_END_TIMEOUT=5

# --- docker-compose.yml only ---
POSTGRES_USER=rnd
POSTGRES_PASSWORD=rnd
POSTGRES_DB=rnd
POSTGRES_PORT=5432
REDIS_PORT=6379
