{
  "name": "rnd",
  "version": "1.0.0",
  "description": "RnD stands for Research and Development or Randomized, depending on how you use it. It is a flexible learning and remediation system built on daily memos, which can be stacked over time. It records what you learn, schedules reviews, and turns weak recall into concrete practice tasks.",
  "keywords": [
    "Improvement",
    "Memo"
  ],
  "license": "ISC",
  "author": "Wijoyo Raharjo Murti Indra Wahyono",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "test": "vitest run",
    "format": "oxfmt src",
    "check": "oxfmt src --check",
    "lint": "oxlint src && tsc --noEmit",
    "lint:fix": "oxlint src --fix",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "1.0.0-rc.5",
    "fallow": "^3.38.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.90.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-node": "^12.0.0",
    "@nestjs/terminus": "^12.0.0",
    "drizzle-orm": "1.0.0-rc.5",
    "pino": "^10.4.0",
    "postgres": "^4.0.0",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  }
}
